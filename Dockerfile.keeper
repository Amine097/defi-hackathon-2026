# FAULTLINE hosted keeper (Railway). Local Anvil test chain + keeper service + read-only status API in one container.
# Never transacts on Ethereum mainnet; the keeper key is a PUBLIC Anvil test account. See docs/backend/RAILWAY_KEEPER_DEPLOYMENT.md
FROM python:3.12-slim

ARG FOUNDRY_VERSION=v1.8.5
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH=/root/.foundry/bin:$PATH FAULTLINE_DATA_DIR=/data

RUN apt-get update && apt-get install -y --no-install-recommends curl git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -sSL https://foundry.paradigm.xyz | bash \
    && foundryup --install "$FOUNDRY_VERSION" \
    && anvil --version && cast --version

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Solidity dependencies pinned exactly like contracts/install_deps.ps1 (tag + verified commit prefix), then forge build
# (the full build: Morpho Blue's artifact is produced through the test helper that imports it)
COPY contracts/ contracts/
RUN set -e; cd contracts; mkdir -p lib; \
    dep() { git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$3" "$2" "lib/$1"; \
            h=$(git -C "lib/$1" rev-parse HEAD); case "$h" in "$4"*) echo "$1 $3 $h";; \
            *) echo "$1: HEAD $h does not match pinned $4" >&2; exit 1;; esac; }; \
    dep forge-std https://github.com/foundry-rs/forge-std v1.17.0 f3dae6e6ee; \
    dep openzeppelin-contracts https://github.com/OpenZeppelin/openzeppelin-contracts v5.6.1 5fd1781b14; \
    dep morpho-blue https://github.com/morpho-org/morpho-blue v1.0.0 55d2d99304; \
    forge build \
    && test -f out/Morpho.sol/Morpho.json && test -f out/RescueVault.sol/RescueVault.json && test -f out/LocalSim.sol/SimFeed.json

COPY src/ src/
COPY data/countermove/demo/ data/countermove/demo/
COPY scripts/railway_keeper.py scripts/

VOLUME ["/data"]
EXPOSE 8080
CMD ["python", "scripts/railway_keeper.py"]
